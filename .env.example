# ─── Database ─────────────────────────────────────────────────────────────────
#
# Set DATABASE_URL to your Postgres connection string.
#
# On Vercel:
#   1. Go to your project → Storage tab → click your Postgres store
#   2. Click the ".env.local" tab inside the store — copy the connection string
#      next to POSTGRES_URL (or POSTGRES_PRISMA_URL, whichever is shown)
#   3. Add it as DATABASE_URL in project Settings → Environment Variables
#
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# ─── Sportradar (optional until tournament starts) ────────────────────────────
#
# Sign up at developer.sportradar.com — Golf Trial plan.
# Leave blank for now; the app runs fine without it.
# Live scores will show "—" until the key is added and the ingest cron runs.
SPORTRADAR_API_KEY=""

# ─── Cron / setup protection ──────────────────────────────────────────────────
#
# Random secret used to protect POST /api/cron/ingest and POST /api/setup.
# Generate one: openssl rand -hex 32
CRON_SECRET="change_me_to_a_random_secret"

# ─── Payment config ───────────────────────────────────────────────────────────
#
# Your Venmo username (no @ prefix) and the entry fee shown on /pay.
# Defaults to "MastersPool2026" / $20 if not set.
VENMO_HANDLE="YourVenmoHandle"
ENTRY_FEE_USD="20"

# ─── Setup checklist ──────────────────────────────────────────────────────────
#
# 1. Vercel project → Storage → Create Database → Postgres (if not done yet)
# 2. Copy the connection string from the store's ".env.local" tab
# 3. Vercel project → Settings → Environment Variables → add:
#      DATABASE_URL  = <connection string from step 2>
#      CRON_SECRET   = <random secret>
#      VENMO_HANDLE  = <your Venmo handle>
#      ENTRY_FEE_USD = 20
# 4. Deploy (git push) — build will succeed (no DB needed at build time)
# 5. After deploy, run the one-time setup to create tables + seed data:
#      curl -X POST https://your-app.vercel.app/api/setup \
#        -H "x-setup-secret: <your CRON_SECRET value>"
#    You should get: {"ok":true,"log":["prisma db push: ok", ...]}
