# PostgreSQL connection string
DATABASE_URL="postgresql://user:password@localhost:5432/masters_pool_2026"

# Sportradar API key (server-side only — never expose to client)
SPORTRADAR_API_KEY="your_sportradar_api_key_here"

# Sportradar tournament ID for the 2026 Masters
SPORTRADAR_TOURNAMENT_ID="sr:tournament:masters2026"

# Shared secret for POST /api/scores/sync (cron job auth)
CRON_SECRET="change_me_to_a_random_secret"

# Venmo payment config (used by seed + /pay page)
VENMO_HANDLE="YourVenmoHandle"
ENTRY_FEE_USD="20"
