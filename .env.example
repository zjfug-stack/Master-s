# ─── Database — Vercel Postgres (auto-populated when you add the storage) ─────
#
# Go to your Vercel project → Storage tab → Create Postgres store.
# Vercel will automatically add these two vars to your project:
POSTGRES_PRISMA_URL="postgresql://..."     # pooled connection (used by the app)
POSTGRES_URL_NON_POOLING="postgresql://..."# direct connection (used by prisma db push)

# ─── Sportradar (optional until tournament starts) ────────────────────────────
#
# Sign up at developer.sportradar.com — Golf Trial plan.
# Leave blank for now; the app runs fine without it.
# Live scores will show "—" until the key is added and the cron runs.
SPORTRADAR_API_KEY=""

# ─── Cron protection ──────────────────────────────────────────────────────────
#
# Random secret that protects POST /api/cron/ingest.
# Generate one: openssl rand -hex 32
CRON_SECRET="change_me_to_a_random_secret"

# ─── Payment config ───────────────────────────────────────────────────────────
#
# Your Venmo username (no @ prefix) and the entry fee shown on /pay.
# Defaults to "MastersPool2026" / $20 if not set.
VENMO_HANDLE="YourVenmoHandle"
ENTRY_FEE_USD="20"

# ─── Setup checklist ──────────────────────────────────────────────────────────
#
# Vercel (one-time):
#   1. Vercel project → Storage → Create Database → Postgres
#   2. Vercel project → Settings → Environment Variables → add:
#        SPORTRADAR_API_KEY, CRON_SECRET, VENMO_HANDLE, ENTRY_FEE_USD
#   3. Push / redeploy — vercel.json runs:
#        prisma db push   → creates all tables
#        prisma db seed   → inserts Pool 2026 + Tiers 1-6
#        npm run build    → builds the Next.js app
#
# Local dev (optional — only if you have a local Postgres):
#   1. cp .env.example .env.local
#   2. Fill in real values for POSTGRES_PRISMA_URL and POSTGRES_URL_NON_POOLING
#      (use the same URL for both when not using PgBouncer locally)
#   3. npm run db:push && npm run db:seed && npm run dev
