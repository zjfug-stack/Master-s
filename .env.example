# ─── Required ─────────────────────────────────────────────────────────────────

# PostgreSQL connection string (Vercel Postgres / Neon / Supabase / local)
DATABASE_URL="postgresql://user:password@localhost:5432/masters_pool_2026"

# Sportradar Golf API key (get one at developer.sportradar.com — Golf Trial plan)
# NEVER expose this to the client — only used in server-side API routes.
SPORTRADAR_API_KEY="your_sportradar_api_key_here"

# Secret for POST /api/cron/ingest — use a random string (e.g. openssl rand -hex 32)
CRON_SECRET="change_me_to_a_random_secret"

# ─── Payment config (used by /pay page and seed) ──────────────────────────────

VENMO_HANDLE="YourVenmoHandle"
ENTRY_FEE_USD="20"

# ─── Setup steps ──────────────────────────────────────────────────────────────
#
# Local dev:
#   1. cp .env.example .env.local
#   2. Fill in DATABASE_URL (needs a running Postgres instance)
#   3. npm run db:push        # apply schema to DB
#   4. npm run db:seed        # insert Pool 2026 + Tiers 1-6
#   5. npm run dev
#
# Vercel:
#   1. Set all vars above in Vercel → Settings → Environment Variables
#   2. vercel.json buildCommand runs `prisma db push` automatically on every deploy
#   3. After first deploy, seed the DB once:
#        npx vercel env pull .env.local && npm run db:seed
#      or connect to your DB directly and run: npm run db:seed
